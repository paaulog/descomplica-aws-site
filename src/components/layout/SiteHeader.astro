---
import type { AnchorMap } from '../../lib/i18n/anchors';
import { localizedPath } from '../../lib/i18n/routes';
import { createTranslator, type Locale } from '../../lib/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  path: string;
  anchorMap?: AnchorMap | undefined;
}

const { locale, path, anchorMap } = Astro.props;
const t = createTranslator(locale);
---

<header class="pointer-events-none sticky top-0 z-40 h-(--header-height) px-3 pt-3 sm:px-6">
  <div class="glass pointer-events-auto mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 rounded-full pr-2 pl-4 sm:pl-5">
    <a
      href={localizedPath(locale, '/')}
      class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight"
      aria-label={t('header.home')}
    >
      <svg class="size-7" viewBox="0 0 28 28" aria-hidden="true">
        <rect x="2" y="3" width="24" height="5.5" rx="2" fill="#ff9900"></rect>
        <rect x="2" y="11.25" width="16" height="5.5" rx="2" fill="#ff9900" opacity="0.75"></rect>
        <rect x="2" y="19.5" width="9" height="5.5" rx="2" fill="#ff9900" opacity="0.5"></rect>
      </svg>
      <span>{t('site.title')}</span>
    </a>
    <div class="flex items-center gap-1">
      <LanguageSwitcher locale={locale} path={path} anchorMap={anchorMap} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
