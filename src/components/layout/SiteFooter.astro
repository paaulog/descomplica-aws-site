---
import { createTranslator, type Locale } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const t = createTranslator(Astro.props.locale);
---

<footer class="mt-24 px-3 pb-6 sm:px-6">
  <div class="glass mx-auto flex max-w-6xl flex-col gap-3 rounded-3xl px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-display text-base font-semibold text-fg">{t('site.title')}</p>
      <p class="mt-2 max-w-2xl">{t('footer.disclaimer')}</p>
    </div>
    <span
      class="h-1.5 w-24 shrink-0 rounded-full bg-gradient-to-r from-[#ff9900] via-[#00a1c9] to-[#7aa116]"
      aria-hidden="true"
    ></span>
  </div>
</footer>
