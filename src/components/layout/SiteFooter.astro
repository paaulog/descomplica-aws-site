---
import { createTranslator, type Locale } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const t = createTranslator(Astro.props.locale);
---

<footer class="mt-24 border-t border-border px-5 py-10 sm:px-8">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 text-sm text-muted sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-display text-base font-semibold text-fg">{t('site.title')}</p>
      <p class="mt-2 max-w-2xl leading-relaxed">{t('footer.disclaimer')}</p>
    </div>
    <span class="mt-1 flex shrink-0 gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-sm bg-[#ff9900]"></span>
      <span class="size-2.5 rounded-sm bg-[#7aa116]"></span>
      <span class="size-2.5 rounded-sm bg-[#00a1c9]"></span>
      <span class="size-2.5 rounded-sm bg-[#8c4fff]"></span>
    </span>
  </div>
</footer>
