---
import { createTranslator, type Locale } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const t = createTranslator(Astro.props.locale);
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-muted sm:px-6">
    <p class="font-medium text-fg">{t('site.title')}</p>
    <p class="mt-2 max-w-2xl">{t('footer.disclaimer')}</p>
  </div>
</footer>
