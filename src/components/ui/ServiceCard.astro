---
import type { Service } from '../../data/services';
import { localizedPath } from '../../lib/i18n/routes';
import { createTranslator, type Locale } from '../../lib/i18n/ui';
import ServiceIcon from '../art/ServiceIcon.astro';

interface Props {
  service: Service;
  locale: Locale;
}

const { service, locale } = Astro.props;
const t = createTranslator(locale);
const isActive = service.status === 'active';
---

<article
  class:list={[
    'service-card panel group relative flex h-full flex-col p-5 transition-colors duration-200',
    isActive ? 'service-card--active hover:border-(--art)' : 'opacity-80',
  ]}
  data-service={service.id}
  data-status={service.status}
>
  <span
    class="mb-6 grid size-11 place-items-center rounded-xl bg-(--art) text-[#10151f]"
    aria-hidden="true"
  >
    <ServiceIcon id={service.id} class="size-6" />
  </span>
  <h3 class="font-display text-xl font-semibold tracking-tight">
    {isActive ? (
      <a
        href={localizedPath(locale, `/${service.id}/`)}
        class="after:absolute after:inset-0 after:rounded-[0.875rem] focus-visible:outline-none"
      >
        {service.title[locale]}
      </a>
    ) : (
      service.title[locale]
    )}
  </h3>
  <p class="mt-2 flex-1 leading-relaxed text-muted">{service.tagline[locale]}</p>
  {isActive ? (
    <span class="mt-6 text-sm font-semibold text-accent" aria-hidden="true">
      {t('service.cta')} <span class="service-arrow inline-block transition-transform">→</span>
    </span>
  ) : (
    <span class="mt-6 inline-flex w-fit rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted">
      {t('service.status.soon')}
    </span>
  )}
</article>

<style>
  .service-card--active:hover .service-arrow {
    transform: translateX(4px);
  }

  /* The stretched link covers the card, so the focus ring is drawn on the card itself. */
  article:has(a:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-arrow {
      transition: none;
    }
  }
</style>
