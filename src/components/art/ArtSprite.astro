---
// Shared gradients and symbols for every illustration; rendered once per page by BaseLayout.
---

<svg width="0" height="0" class="pointer-events-none absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-bucket" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--art)"></stop>
      <stop offset="1" style="stop-color: color-mix(in oklab, var(--art) 82%, black)"></stop>
    </linearGradient>
    <linearGradient id="g-paper" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" style="stop-color: light-dark(#ffffff, #eef4ff)"></stop>
      <stop offset="1" style="stop-color: light-dark(#dfe8f6, #a9bdd9)"></stop>
    </linearGradient>
    <linearGradient id="g-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: #ffffff; stop-opacity: 0.7"></stop>
      <stop offset="1" style="stop-color: #ffffff; stop-opacity: 0.12"></stop>
    </linearGradient>
    <linearGradient id="g-ink" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: #1b2a44"></stop>
      <stop offset="1" style="stop-color: #0a1220"></stop>
    </linearGradient>
    <linearGradient id="g-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: #2bb4dc"></stop>
      <stop offset="1" style="stop-color: #0a8fbd"></stop>
    </linearGradient>
    <linearGradient id="g-orange" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: #ffa21f"></stop>
      <stop offset="1" style="stop-color: #f08400"></stop>
    </linearGradient>
    <linearGradient id="g-cloud" gradientUnits="userSpaceOnUse" x1="0" y1="10" x2="0" y2="116">
      <stop offset="0" style="stop-color: light-dark(#ffffff, #f2f7ff)"></stop>
      <stop offset="1" style="stop-color: light-dark(#cfdcf0, #8fa8cc)"></stop>
    </linearGradient>
  </defs>

  <symbol id="art-bucket" viewBox="0 0 120 140">
    <ellipse cx="60" cy="128" rx="46" ry="9" fill="#000" opacity="0.2"></ellipse>
    <path d="M12 30 24 118Q60 134 96 118L108 30Z" fill="url(#g-bucket)"></path>
    <ellipse cx="60" cy="30" rx="48" ry="14" style="fill: var(--art-deep)"></ellipse>
    <ellipse cx="60" cy="33" rx="39" ry="9" fill="#000" opacity="0.4"></ellipse>
    <ellipse
      cx="60"
      cy="30"
      rx="48"
      ry="14"
      fill="none"
      style="stroke: var(--art-light)"
      stroke-width="3"
    ></ellipse>
  </symbol>

  <symbol id="art-file" viewBox="0 0 56 70">
    <path
      d="M8 0h28l20 20v42a8 8 0 0 1-8 8H8a8 8 0 0 1-8-8V8a8 8 0 0 1 8-8Z"
      fill="url(#g-paper)"
    ></path>
    <path d="M36 0l20 20H44a8 8 0 0 1-8-8Z" fill="#000" opacity="0.12"></path>
    <rect x="10" y="32" width="30" height="5" rx="2.5" style="fill: var(--art)"></rect>
    <rect
      x="10"
      y="43"
      width="36"
      height="5"
      rx="2.5"
      style="fill: var(--art)"
      opacity="0.45"
    ></rect>
    <rect
      x="10"
      y="54"
      width="22"
      height="5"
      rx="2.5"
      style="fill: var(--art)"
      opacity="0.45"
    ></rect>
  </symbol>

  <symbol id="art-cloud" viewBox="0 0 200 120">
    <g fill="url(#g-cloud)">
      <circle cx="48" cy="82" r="30"></circle>
      <circle cx="94" cy="52" r="40"></circle>
      <circle cx="142" cy="64" r="34"></circle>
      <circle cx="166" cy="88" r="26"></circle>
      <rect x="48" y="80" width="118" height="34" rx="2"></rect>
    </g>
    <path
      d="M70 28Q94 14 120 30"
      stroke="#fff"
      stroke-opacity="0.8"
      stroke-width="4"
      stroke-linecap="round"
      fill="none"
    ></path>
  </symbol>

  <symbol id="art-ico-s3" viewBox="0 0 48 48">
    <ellipse cx="24" cy="13" rx="16" ry="5"></ellipse>
    <path d="M8 13l4 26a4 4 0 0 0 4 3.5h16a4 4 0 0 0 4-3.5l4-26"></path>
  </symbol>

  <symbol id="art-ico-ec2" viewBox="0 0 48 48">
    <rect x="7" y="9" width="34" height="13" rx="3.5"></rect>
    <rect x="7" y="26" width="34" height="13" rx="3.5"></rect>
    <path d="M13 15.5h.01M13 32.5h.01M33 15.5h4M33 32.5h4"></path>
  </symbol>

  <symbol id="art-ico-lambda" viewBox="0 0 48 48">
    <path d="M14 8h6l18 32"></path>
    <path d="M27.5 22 12 40"></path>
  </symbol>

  <symbol id="art-ico-vpc" viewBox="0 0 48 48">
    <rect x="6" y="6" width="36" height="36" rx="9" stroke-dasharray="4 3.5"></rect>
    <circle cx="17" cy="17" r="3.5"></circle>
    <circle cx="31" cy="17" r="3.5"></circle>
    <circle cx="24" cy="31" r="3.5"></circle>
    <path d="M20.5 17h7M19 20l3.5 8M29 20l-3.5 8"></path>
  </symbol>
</svg>
