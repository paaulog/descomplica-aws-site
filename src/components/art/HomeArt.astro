---
// Home hero: a cloud hub with the four services orbiting it, each in its AWS category color.
const orbit = [
  { id: 'ec2', x: 92, y: 74, color: '#ed7100', delay: 0 },
  { id: 's3', x: 468, y: 74, color: '#7aa116', delay: -1.4 },
  { id: 'lambda', x: 92, y: 300, color: '#f5a300', delay: -2.8 },
  { id: 'vpc', x: 468, y: 300, color: '#8c4fff', delay: -4.2 },
] as const;
---

<svg class="art-svg" viewBox="0 0 560 380" role="presentation" aria-hidden="true" focusable="false">
  <ellipse class="art-ground" cx="280" cy="350" rx="190" ry="12"></ellipse>
  {orbit.map((node) => (
    <path
      class="art-flow"
      fill="none"
      stroke={node.color}
      stroke-width="3"
      opacity="0.85"
      d={`M${node.x} ${node.y}Q280 ${node.y < 190 ? 90 : 300} 280 190`}
    />
  ))}
  <g class="art-float" style="--amp: 8px; --dur: 7s">
    <use href="#art-cloud" x="170" y="48" width="220" height="132"></use>
  </g>
  <use
    href="#art-bucket"
    x="226"
    y="150"
    width="108"
    height="126"
    style="--art: #ff9900; --art-light: #ffc15a; --art-deep: #a85f00"
  ></use>
  {orbit.map((node) => (
    <g class="art-float" style={`--amp: 9px; --dur: 6s; --delay: ${node.delay}s`}>
      <g transform={`translate(${node.x} ${node.y})`}>
        <rect class="art-glass" x="-44" y="-44" width="88" height="88" rx="26" />
        <rect x="-44" y="-44" width="88" height="88" rx="26" fill={node.color} opacity="0.92" />
        <rect x="-44" y="-44" width="88" height="88" rx="26" fill="url(#g-glass)" opacity="0.55" />
        <use
          href={`#art-ico-${node.id}`}
          x="-22"
          y="-22"
          width="44"
          height="44"
          fill="none"
          stroke="#10151f"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: #fff"
        ></use>
      </g>
    </g>
  ))}
  <g class="art-pulse">
    <use href="#art-spark" x="250" y="40" width="22" height="22"></use>
  </g>
  <g class="art-pulse" style="--delay: 1s">
    <use href="#art-spark" x="300" y="330" width="16" height="16"></use>
  </g>
  <g class="art-pulse" style="--delay: 1.8s">
    <use href="#art-spark" x="30" y="190" width="14" height="14"></use>
  </g>
</svg>
