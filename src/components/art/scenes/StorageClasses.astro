---
const tiers = [
  { y: 24, from: '#ff7a2f', to: '#ffb347', width: 280, coin: 15 },
  { y: 80, from: '#ffc247', to: '#ffe08a', width: 264, coin: 12 },
  { y: 136, from: '#6fd6f2', to: '#3fa7e0', width: 248, coin: 9 },
  { y: 192, from: '#4c8dff', to: '#7ea6ff', width: 232, coin: 6 },
] as const;
---

<defs>
  {tiers.map((tier, index) => (
    <linearGradient id={`g-tier-${index}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={tier.from} />
      <stop offset="1" stop-color={tier.to} />
    </linearGradient>
  ))}
</defs>
{tiers.map((tier, index) => (
  <g>
    <rect
      x="110"
      y={tier.y}
      width={tier.width}
      height="40"
      rx="16"
      fill={`url(#g-tier-${index})`}
    />
    <rect
      x="110"
      y={tier.y}
      width={tier.width}
      height="40"
      rx="16"
      fill="url(#g-glass)"
      opacity="0.5"
    />
    <rect
      x="132"
      y={tier.y + 16}
      width={90 - index * 12}
      height="8"
      rx="4"
      fill="#0b1220"
      opacity="0.35"
    />
    <circle
      cx="446"
      cy={tier.y + 20}
      r={tier.coin}
      fill="#ffc247"
      stroke="#fff"
      stroke-opacity="0.6"
      stroke-width="2"
    />
  </g>
))}
<g class="art-pulse" style="--scale: 1.12">
  <path
    d="M60 38c10 10 12 20 6 30 8-3 16-12 14-24 12 10 16 28 4 40-14 14-40 8-44-12 0-12 8-16 12-22 0 6 4 8 8 6-6-8-4-14 0-18Z"
    fill="url(#g-orange)"
  ></path>
</g>
<g class="art-spin" style="--dur: 18s">
  <g class="art-line" transform="translate(70 212)">
    <path d="M0-20V20M-17-10 17 10M-17 10 17-10" stroke="#8fd3ff" stroke-width="3"></path>
  </g>
</g>
<g class="art-travel" style="--path: path('M180 20V200'); --dur: 5.5s">
  <use href="#art-file" x="-12" y="-15" width="24" height="30"></use>
</g>
