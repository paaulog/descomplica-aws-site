---
import { isServiceId } from '../../data/services';
import { getServiceSections } from '../../lib/content';
import { splitLocale } from '../../lib/i18n/routes';
import { createTranslator } from '../../lib/i18n/ui';

const locale = splitLocale(Astro.url.pathname).locale;
const t = createTranslator(locale);
const { service } = Astro.params;
if (!isServiceId(service)) {
  throw new Error(`<Summary> só pode ser usado na página de um serviço (recebeu "${service}")`);
}
// Skips the opening and the closing section, which is where the summary itself lives.
const recap = (await getServiceSections(service, locale)).slice(1, -1);
---

<div>
  <p class="text-sm font-semibold tracking-widest text-accent uppercase">{t('summary.label')}</p>
  <ol class="mt-4 grid list-none gap-3 pl-0 sm:grid-cols-2">
    {recap.map((section) => (
      <li
        class="glass glass-spot rounded-2xl p-4 transition-transform duration-300 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
        data-spot
      >
        <a
          href={`#${section.data.anchor}`}
          class="font-display font-bold no-underline! hover:text-accent"
        >
          {section.data.navLabel}
        </a>
        <p class="mt-1 text-sm text-muted">{section.data.summary}</p>
      </li>
    ))}
  </ol>
</div>
