---
import { author } from '../../data/author';
import { getNextService } from '../../data/services';
import { localizedPath, splitLocale } from '../../lib/i18n/routes';
import { fillTemplate } from '../../lib/i18n/template';
import { createTranslator } from '../../lib/i18n/ui';

const S3_CONSOLE_URL = 'https://console.aws.amazon.com/s3/';

const locale = splitLocale(Astro.url.pathname).locale;
const t = createTranslator(locale);
const nextService = getNextService();
// "Soon" services have no page yet, so the link points to their card on the home page.
const servicesListHref = `${localizedPath(locale, '/')}#services-heading`;
---

<nav class="grid gap-4" aria-labelledby="next-steps-heading" data-next-steps>
  <p id="next-steps-heading" class="text-sm font-medium text-muted">
    {t('nextSteps.heading')}
  </p>
  <a
    href={S3_CONSOLE_URL}
    rel="noopener"
    class="rounded-xl bg-accent px-5 py-4 font-semibold text-bg no-underline! hover:opacity-90"
    data-next-try
  >
    {t('nextSteps.tryIt')} →
  </a>
  {nextService && (
    <a
      href={servicesListHref}
      class="rounded-xl border border-dashed border-border px-5 py-4 font-medium text-fg no-underline! hover:border-accent"
      data-next-service
    >
      {fillTemplate(t('nextSteps.nextService'), { service: nextService.title[locale] })}{' '}
      <span class="text-sm text-muted">({t('nextSteps.soon')})</span>
    </a>
  )}
  <div class="rounded-xl border border-border bg-surface px-5 py-4">
    <p class="text-base">{t('nextSteps.author')}</p>
    <ul class="mt-3 flex list-none! flex-wrap gap-3 pl-0!">
      {author.links.map((link) => (
        <li>
          <a
            href={link.href}
            rel="noopener me"
            class="inline-flex rounded-md border border-border px-3 py-1.5 text-sm font-medium text-fg no-underline! hover:border-accent"
            data-author-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
