---
import { getActiveServices, services } from '../../data/services';
import { localizedPath } from '../../lib/i18n/routes';
import { createTranslator, type Locale } from '../../lib/i18n/ui';
import { getOgImagePath, HOME_OG_SLUG } from '../../lib/og/paths';
import HomeArt from '../art/HomeArt.astro';
import BaseLayout from '../layout/BaseLayout.astro';
import ServiceCard from '../ui/ServiceCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
const sorted = services.toSorted((first, second) => first.order - second.order);
const [firstActive] = getActiveServices();
---

<BaseLayout locale={locale} path="/" image={getOgImagePath(locale, HOME_OG_SLUG)}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <section class="grid items-center gap-12 pt-10 pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:pt-20 lg:pb-28">
      <div>
        <h1 class="font-display text-[2.75rem] leading-[1.04] font-bold tracking-[-0.03em] text-balance sm:text-6xl lg:text-7xl">
          {t('home.title')}
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-pretty text-muted sm:text-xl">
          {t('home.lead')}
        </p>
        {firstActive && (
          <a
            href={localizedPath(locale, `/${firstActive.id}/`)}
            class="btn-primary mt-10"
            data-home-cta
          >
            {t('service.cta')} · {firstActive.title[locale]}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
      <div class="art-stage glass" data-art-stage>
        <HomeArt />
      </div>
    </section>
    <section aria-labelledby="services-heading" class="pb-8">
      <h2
        id="services-heading"
        class="scroll-mt-24 font-display text-2xl font-semibold tracking-tight"
      >
        {t('home.servicesHeading')}
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {sorted.map((service) => (
          <li>
            <ServiceCard service={service} locale={locale} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import { observeArtStages } from '../../lib/ui/art-visibility';

  observeArtStages([...document.querySelectorAll('[data-art-stage]')]);
</script>
