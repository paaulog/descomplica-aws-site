---
import { services } from '../../data/services';
import { createTranslator, type Locale } from '../../lib/i18n/ui';
import { getOgImagePath, HOME_OG_SLUG } from '../../lib/og/paths';
import BaseLayout from '../layout/BaseLayout.astro';
import ServiceCard from '../ui/ServiceCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
const sorted = services.toSorted((first, second) => first.order - second.order);
---

<BaseLayout locale={locale} path="/" image={getOgImagePath(locale, HOME_OG_SLUG)}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="max-w-3xl pt-20 pb-16 sm:pt-28">
      <p class="text-sm font-medium tracking-wide text-muted uppercase">{t('home.eyebrow')}</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        {t('home.title')}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-muted sm:text-xl">{t('home.lead')}</p>
    </section>
    <section aria-labelledby="services-heading">
      <h2 id="services-heading" class="text-sm font-medium tracking-wide text-muted uppercase">
        {t('home.servicesHeading')}
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {sorted.map((service) => (
          <li>
            <ServiceCard service={service} locale={locale} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
