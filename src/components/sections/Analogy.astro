---
import { splitLocale } from '../../lib/i18n/routes';
import { createTranslator } from '../../lib/i18n/ui';

interface Props {
  title?: string;
}

const t = createTranslator(splitLocale(Astro.url.pathname).locale);
const { title } = Astro.props;
---

<aside class="rounded-2xl border border-border bg-surface p-6">
  <p class="flex items-center gap-2 text-sm font-medium text-accent">
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"></path>
    </svg>
    {t('analogy.label')}
  </p>
  {title && <p class="mt-3 text-lg font-semibold">{title}</p>}
  <div class="mt-3 space-y-3">
    <slot />
  </div>
</aside>
