---
import { splitLocale } from '../../lib/i18n/routes';
import { createTranslator } from '../../lib/i18n/ui';

interface Props {
  title: string;
  /** Public source backing a real-world claim (company examples must cite one). */
  source?: string;
  sourceLabel?: string;
}

const { title, source, sourceLabel } = Astro.props;
const t = createTranslator(splitLocale(Astro.url.pathname).locale);
---

<div
  class="card glass glass-spot flex flex-col rounded-3xl p-5 transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
  data-spot
>
  <span
    class="mb-3 block h-1.5 w-9 rounded-full bg-gradient-to-r from-(--art-light) to-(--art)"
    aria-hidden="true"
  ></span>
  <p class="font-display text-lg leading-snug font-bold text-fg">{title}</p>
  <div class="mt-2 flex-1 text-base leading-relaxed text-muted [&_strong]:text-fg">
    <slot />
  </div>
  {source && (
    <p class="mt-3 text-sm text-muted">
      {t('card.source')}:{' '}
      <a href={source} rel="noopener" class="text-accent underline underline-offset-2">
        {sourceLabel ?? new URL(source).hostname}
      </a>
    </p>
  )}
</div>
