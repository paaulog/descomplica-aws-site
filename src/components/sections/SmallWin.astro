---
import { splitLocale } from '../../lib/i18n/routes';
import { createTranslator } from '../../lib/i18n/ui';

const t = createTranslator(splitLocale(Astro.url.pathname).locale);
---

<div class="glass flex items-center gap-4 rounded-2xl bg-accent-soft p-4 pr-5">
  <span class="grid size-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-[#6ee7b7] to-[#10b981] text-[#04251a] shadow-[0_8px_20px_-6px_#10b981]">
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </span>
  <div>
    <p class="sr-only">{t('smallWin.label')}</p>
    <div class="font-semibold text-fg">
      <slot />
    </div>
  </div>
</div>
