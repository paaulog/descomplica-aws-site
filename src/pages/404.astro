---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { localizedPath } from '../lib/i18n/routes';
import { createTranslator, defaultLocale, htmlLang, locales } from '../lib/i18n/ui';

// A static host serves one 404.html for every locale, so the page carries both languages.
const messages = locales.map((locale) => ({ locale, t: createTranslator(locale) }));
const pageTitle = messages.map(({ t }) => t('notFound.title')).join(' · ');
---

<BaseLayout locale={defaultLocale} title={pageTitle}>
  <div class="mx-auto grid max-w-6xl gap-16 px-4 pt-20 sm:px-6 sm:pt-28 md:grid-cols-2">
    {messages.map(({ locale, t }, index) => (
      <section lang={htmlLang[locale]}>
        <p class="font-mono text-sm text-muted">404</p>
        {index === 0 ? (
          <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            {t('notFound.title')}
          </h1>
        ) : (
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            {t('notFound.title')}
          </h2>
        )}
        <p class="mt-4 text-muted">{t('notFound.body')}</p>
        <a
          href={localizedPath(locale, '/')}
          class="mt-6 inline-block font-medium underline underline-offset-4"
        >
          {t('notFound.home')}
        </a>
      </section>
    ))}
  </div>
</BaseLayout>
